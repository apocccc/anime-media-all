# ===== データベース (Supabase Postgres / ローカルPostgres) =====
# アプリ実行用: Transaction pooler (ポート6543)。
# 注意: pgbouncer=true と connection_limit=10 を必ず付ける
#  - 直結 db.<ref>.supabase.co は IPv6 専用のため Vercel から接続不可 → pooler を使う
#  - connection_limit=1 だとビルドの並列静的生成で pool timeout する
#  - パスワードは英数字のみにする(記号は URL エンコードが必要)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&sslmode=require"

# マイグレーション用: Session pooler (ポート5432)
DIRECT_DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ===== サイト =====
# ドメイン: animerelay.com / サイト名: Anime Relay。コードはこの環境変数のみ参照(ハードコード禁止)
# 本番: NEXT_PUBLIC_SITE_URL="https://animerelay.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Anime Relay"
# 公開画像のカスタムドメイン (R2)。本番: img.animerelay.com
NEXT_PUBLIC_IMG_HOST=""
# 問い合わせ先メール(未設定なら contact@<ドメイン> を自動生成)
NEXT_PUBLIC_CONTACT_EMAIL=""

# ===== 認証 =====
# `openssl rand -base64 32` で生成
AUTH_SECRET=""
# プレビューURL署名用
PREVIEW_SECRET=""

# 会員OAuth(設定したプロバイダーのみ有効化される)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
AUTH_TWITTER_ID=""
AUTH_TWITTER_SECRET=""

# ===== Cloudflare R2 (公開画像ストレージ) =====
# R2_* が揃っていると R2 に保存(なければ Vercel Blob → ローカルの順にフォールバック)
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="animerelay-public"
# カスタムドメインの公開URL(末尾スラッシュなし)
R2_PUBLIC_BASE_URL=""

# ===== Vercel Blob (R2を使わない場合の代替) =====
BLOB_READ_WRITE_TOKEN=""

# ===== AI(役割別モデル設定。§11) =====
# openai | anthropic | mock(mock はローカル開発用の決定的応答・APIキー不要)
# 自動翻訳を有効にするには openai を選び OPENAI_API_KEY を設定する。
AI_PROVIDER="openai"
# OpenAI APIキー(https://platform.openai.com/api-keys)
OPENAI_API_KEY=""
# 記事生成(日本語マスター)
AI_MODEL_WRITE="gpt-4o"
# 翻訳(品質重視の上位モデル)
AI_MODEL_TRANSLATE="gpt-4o"
# モデレーション・固有名詞抽出・分類(軽量モデル)
AI_MODEL_MODERATE="gpt-4o-mini"
# 省略時 gpt-4o-mini
OPENAI_MODEL="gpt-4o-mini"
# 互換エンドポイントを使う場合のみ (Azure等)
OPENAI_BASE_URL=""
# anthropic を使う場合のみ
ANTHROPIC_API_KEY=""

# ===== Cloudflare Turnstile(会員登録・投稿・PR送信フォーム) =====
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ===== Cron 認証 (Vercel Cron からの呼び出し保護。fail-closed) =====
CRON_SECRET=""

# ===== 提携先向けプレスリリースAPI(§7.3。カンマ区切りで複数可) =====
PRESS_API_KEYS=""

# ===== IndexNow =====
INDEXNOW_KEY=""

# ===== プライズ =====
PRIZE_TIMEZONE="Asia/Tokyo"

# ===== アップロード上限(MB) =====
UPLOAD_MAX_MB="8"

# ===== Google Analytics (GA4) =====
# 設定すると公開サイトに計測タグが出力される (管理画面・事業者ポータル・マイページは対象外)
# GA4 の「データストリーム」に表示される測定ID。形式は G-XXXXXXXXXX
# (形式が違う値は出力されない)。手順は docs/ANALYTICS.md
NEXT_PUBLIC_GA_ID=""

# ===== Google Search Console =====
# 「HTML タグ」認証を使う場合のみ設定する。表示された meta タグの content="..." の値だけを入れる
# (<meta ...> ごと貼らない)。複数プロパティを認証する場合はカンマ区切り。
# Cloudflare の DNS TXT レコードで認証する場合は空のままでよい (推奨。docs/ANALYTICS.md)
GOOGLE_SITE_VERIFICATION=""

# ===== Resend (会員登録確認・受賞通知・PR承認通知) =====
RESEND_API_KEY=""

# ===== 本番初期化用 (db:seed:prod で使用) =====
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
