{
  "buildCommand": "npx prisma generate && npx prisma migrate deploy && next build",
  "regions": ["hnd1"],
  "crons": [
    {
      "path": "/api/cron/publish",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/ingest",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/generate",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/jobs",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/glossary-audit",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/prize",
      "schedule": "0 15 * * 0"
    }
  ]
}
